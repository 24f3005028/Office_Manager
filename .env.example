# Office Hub uses typed environment settings. Copy this file to .env and adjust it.
# Never commit .env: it can contain service-account paths and other private values.

OFFICE_HUB_APP_NAME=Office Hub
OFFICE_HUB_ENVIRONMENT=development
OFFICE_HUB_HOST=127.0.0.1
OFFICE_HUB_PORT=8000

# Leave unset to use %LOCALAPPDATA%\OfficeHub\office_hub.sqlite3.
# OFFICE_HUB_DATABASE_URL=sqlite:///C:/OfficeHub/office_hub.sqlite3
# OFFICE_HUB_DATA_DIR=C:\Users\you\AppData\Local\OfficeHub
OFFICE_HUB_BILLING_FOLDER=C:\Office\Billing
OFFICE_HUB_BUSY_EXE_PATH=C:\Program Files\BUSY\BUSY.exe
OFFICE_HUB_BUSY_UI_PROFILE_FILE=
OFFICE_HUB_BUSY_AUTOMATION_ENABLED=false
OFFICE_HUB_BUSY_AUTOMATION_TIMEOUT_SECONDS=120
# OFFICE_HUB_OUTPUT_DIR=C:\Users\you\AppData\Local\OfficeHub\outputs

# Keep false until each live integration has been tested and approved.
OFFICE_HUB_ALLOW_EXTERNAL_ACTIONS=false
OFFICE_HUB_ENABLE_WORKER=true
OFFICE_HUB_ENABLE_SCHEDULER=true
OFFICE_HUB_SCHEDULED_WHATSAPP_ENABLED=false
OFFICE_HUB_SCHEDULER_TIMEZONE=Asia/Kolkata
OFFICE_HUB_WORKER_POLL_SECONDS=2

# The dashboard can display these values, but credentials stay outside source control.
# OFFICE_HUB_GOOGLE_CREDENTIALS_FILE=C:\Users\you\AppData\Local\OfficeHub\google-service-account.json
# OFFICE_HUB_GOOGLE_SHEET_ID=replace-me

# WhatsApp help-chat settings. Keep the provider as dry_run until tested.
OFFICE_HUB_WHATSAPP_PROVIDER=dry_run
OFFICE_HUB_WHATSAPP_ALLOWED_SENDERS=
# OFFICE_HUB_WHATSAPP_CLOUD_ACCESS_TOKEN=do-not-commit
# OFFICE_HUB_WHATSAPP_CLOUD_PHONE_NUMBER_ID=replace-me
# OFFICE_HUB_WHATSAPP_CLOUD_VERIFY_TOKEN=do-not-commit
# OFFICE_HUB_WHATSAPP_CLOUD_APP_SECRET=do-not-commit
