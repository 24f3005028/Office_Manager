# Copy this file to .env and adjust the roots for the machine running the API.
BILLS_ROOTS=E:\BILL LDH 2026-27|E:\BILL PDF 2026-27
CREDIT_NOTES_ROOTS=E:\C N 26-27|E:\C N 2026-27 LDH
DEBIT_NOTES_ROOTS=E:\DEBIT NOTE 26-27|E:\DEBIT NOTE 26-27 LDH

DATABASE_PATH=data/dashboard.sqlite3
PDF_DATE_EXTRACTION=true
# Optional rolling window overrides. Leave blank to use the current and prior
# Indian financial year plus a short future grace period.
PDF_DATE_MIN_DATE=
PDF_DATE_MAX_DATE=
BUSY_INBOX_DIR=data/busy_inbox
BUSY_IGNORED_DIRECTORIES=BusyWin|EInvoiceTemp|EWayBillTemp|SYSTEM|XMPPMessages
BUSY_SERIES_ALIASES={"HSTL": "HSL", "HSL": "HSL", "HST": "HST", "CN": "CN", "DN": "DN"}
BUSY_FINANCIAL_YEAR=26-27
# Additional invoice archives for mobile lookup; current bill folders come from workspace settings.
MOBILE_ARCHIVE_ROOTS=E:/2024-25 BILL PDF|E:/2025-26 BILL PDF
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
BRIDGE_TIMEOUT_SECONDS=30
WHATSAPP_BRIDGE_API_KEY=
WORKER_POLL_SECONDS=0.5
CORS_ORIGINS=http://localhost:3000|http://127.0.0.1:3000

# Manual Pouncha sync only. No schedule, catch-up or startup export exists.
POUNCHA_SPREADSHEET_ID=1Ukd4bteeJryu8wW7hDdQVOaIwG0B6V2qLOKYu-GbcZ0
POUNCHA_SHEET_TAB_NAME=POUNCHA 26-27
GOOGLE_SERVICE_ACCOUNT_FILE=config/google_service_account.json
POUNCHA_COMPANY=H.S. TRADERS
POUNCHA_EXPORT_TIMEOUT_SECONDS=90
