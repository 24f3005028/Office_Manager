# Copy this file to .env and adjust the roots for the machine running the API.
BILLS_ROOTS=E:\BILL LDH 2026-27|E:\BILL PDF 2026-27
CREDIT_NOTES_ROOTS=E:\C N 26-27|E:\C N 2026-27 LDH
DEBIT_NOTES_ROOTS=E:\DEBIT NOTE 26-27|E:\DEBIT NOTE 26-27 LDH

DATABASE_PATH=data/dashboard.sqlite3
PDF_DATE_EXTRACTION=true
# Optional rolling window overrides. Leave blank to use the current and prior
# Indian financial year plus a short future grace period.
PDF_DATE_MIN_DATE=
PDF_DATE_MAX_DATE=
BUSY_INBOX_DIR=data/busy_inbox
BUSY_IGNORED_DIRECTORIES=BusyWin|EInvoiceTemp|EWayBillTemp|SYSTEM|XMPPMessages
BUSY_SERIES_ALIASES={"HSTL": "HSL", "HSL": "HSL", "HST": "HST", "CN": "CN", "DN": "DN"}
BUSY_FINANCIAL_YEAR=26-27
# BUSY 21 desktop automation. The backend must run in the logged-in interactive
# Windows session, not as a Windows service.
BUSY_EXECUTABLE_PATH=E:\C N 26-27\BusyWin\Busy21.exe
BUSY_WINDOW_TITLE_RE=.*BUSY.*
BUSY_EXPECTED_COMPANY_SUBSTRING=H.S. Traders
BUSY_AUTOMATION_TIMEOUT_SECONDS=60
BUSY_MIN_USER_IDLE_SECONDS=3
BUSY_UI_PROFILE_PATH=config/busy_ui_profile.json
BUSY_LOCK_PATH=data/busy_automation.lock
BUSY_AUTOMATION_TEMP_DIR=data/busy_automation
# Pouncha 26-27 daily Google Sheets sync.
POUNCHA_SPREADSHEET_ID=
POUNCHA_SHEET_TAB_NAME=POUNCHA 26-27
GOOGLE_SERVICE_ACCOUNT_FILE=config/google_service_account.json
# Optional local archive. Leave blank to disable writing Pouncha_Sales.xlsx.
POUNCHA_LOCAL_EXCEL_PATH=
POUNCHA_SYNC_ENABLED=true
POUNCHA_SYNC_LOOKBACK_DAYS=3
POUNCHA_CATCHUP_INTERVAL_MINUTES=15
POUNCHA_TIMEZONE=Asia/Kolkata
POUNCHA_LOCK_PATH=data/pouncha_sync.lock
POUNCHA_UPLOAD_DIR=data/pouncha_uploads
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
BRIDGE_TIMEOUT_SECONDS=30
WHATSAPP_BRIDGE_API_KEY=
WORKER_POLL_SECONDS=0.5
CORS_ORIGINS=http://localhost:3000|http://127.0.0.1:3000
