{
  "name": "office-document-whatsapp-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-wwebjs-media-id.cjs && node scripts/patch-wwebjs-message-id.cjs",
    "test": "node scripts/test.cjs",
    "check:patch": "node scripts/patch-wwebjs-media-id.cjs --check && node scripts/patch-wwebjs-message-id.cjs --check"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "2.5.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "1.34.7"
  },
  "trustedDependencies": [
    "puppeteer"
  ],
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.25",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
