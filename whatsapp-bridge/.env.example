# The bridge only binds to loopback by default.
WHATSAPP_BRIDGE_HOST=127.0.0.1
WHATSAPP_BRIDGE_PORT=3001

# Use | between paths. An empty value rejects path-based sends until configured.
WHATSAPP_ALLOWED_ROOTS=E:\\BILL LDH 2026-27|E:\\BILL PDF 2026-27|E:\\C N 26-27|E:\\C N 2026-27 LDH|E:\\DEBIT NOTE 26-27|E:\\DEBIT NOTE 26-27 LDH
WHATSAPP_RUNTIME_DIR=./runtime
WHATSAPP_SEND_DELAY_MS=1200
WHATSAPP_SEND_CAPACITY=8
WHATSAPP_SEND_DEADLINE_MS=120000
WHATSAPP_FILE_READ_TIMEOUT_MS=10000
WHATSAPP_CONTACTS_TIMEOUT_MS=30000
WHATSAPP_INIT_TIMEOUT_MS=90000
WHATSAPP_AUTHENTICATED_TIMEOUT_MS=90000
WHATSAPP_DESTROY_TIMEOUT_MS=10000
WHATSAPP_CONTACTS_CACHE_MS=60000
WHATSAPP_HEADLESS=true

# Optional. By default the bridge uses the system-installed Google Chrome (channel "chrome").
# Set an explicit path when Chrome is not in its default install location, e.g.:
# WHATSAPP_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
WHATSAPP_EXECUTABLE_PATH=

# Optional. When set, clients must send x-api-key or Authorization: Bearer <key>.
WHATSAPP_BRIDGE_API_KEY=

# Optional browser origin allow-list, separated with |.
WHATSAPP_CORS_ORIGINS=http://127.0.0.1:8000|http://localhost:8000
