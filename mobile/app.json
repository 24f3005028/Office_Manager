{
  "expo": {
    "name": "H.S. Traders Office",
    "slug": "hs-traders-office",
    "version": "1.7.1",
    "scheme": "hstraders-office",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.hstraders.office",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 144,
          "backgroundColor": "#f4f6fa"
        }
      ]
    ],
    "extra": {
      "description": "Private, on-demand office statements and bill PDFs"
    }
  }
}
