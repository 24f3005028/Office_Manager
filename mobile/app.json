{
  "expo": {
    "name": "H.S. Traders Office",
    "slug": "hs-traders-office",
    "version": "1.3.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.hstraders.office",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      "expo-background-task",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "description": "Private, on-demand office statements and bill PDFs"
    }
  }
}
