<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp" android:background="@drawable/office_widget_background">
  <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/office_widget_brand" android:textColor="#526A7A" android:textSize="12sp" android:textStyle="bold" />
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:text="@string/office_widget_setup_title" android:textColor="#19314B" android:textSize="18sp"
    android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:text="@string/office_widget_setup_copy" android:textColor="#19314B"
    android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
  <LinearLayout android:id="@+id/widget_task1" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageButton android:id="@+id/widget_done1" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/office_widget_checkbox" android:background="@android:color/transparent" android:contentDescription="@string/office_widget_mark_done"/>
    <TextView android:id="@+id/widget_row1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#19314B" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_task2" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageButton android:id="@+id/widget_done2" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/office_widget_checkbox" android:background="@android:color/transparent" android:contentDescription="@string/office_widget_mark_done"/>
    <TextView android:id="@+id/widget_row2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#19314B" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_task3" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageButton android:id="@+id/widget_done3" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/office_widget_checkbox" android:background="@android:color/transparent" android:contentDescription="@string/office_widget_mark_done"/>
    <TextView android:id="@+id/widget_row3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#19314B" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
  <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:textColor="#526A7A" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="8dp">
    <TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="@string/office_widget_add" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/office_widget_button"/>
    <TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="@string/office_widget_open_tasks" android:textSize="12sp" android:textStyle="bold" android:textColor="#19314B"/>
    <ImageButton android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/office_widget_refresh" android:contentDescription="@string/office_widget_refresh" android:background="@android:color/transparent"/>
  </LinearLayout>
</LinearLayout>
