<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_search_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center_vertical" android:padding="4dp">
  <TextView android:id="@+id/widget_search_bar" android:layout_width="match_parent" android:layout_height="56dp"
    android:background="@drawable/office_widget_background" android:gravity="center_vertical"
    android:paddingStart="18dp" android:paddingEnd="12dp" android:text="@string/office_widget_search_party"
    android:textColor="#19314B" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"
    android:drawableStart="@drawable/office_widget_search_icon" android:drawablePadding="12dp" />
</LinearLayout>
